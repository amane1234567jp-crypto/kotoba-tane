{
"key": "sr_knadana",
"who": "kuma",
"text": "やきおまんじゅう？ あはは、いいね！"
},
{
"key": "sg_knoshieru_5",
"who": "gao",
"text": "じゃんけんを して、まけた ひとに、たべものの あだなを つけるんだよ。やきおまんじゅう とか、ゆでたけのこ とか"
},
{
"key": "sr_knwaruguchi",
"who": "tora",
"text": "そうだね、ごめん。じゃあ、あげちくわ！"
},
{
"key": "sg_knadana_0",
"who": "gao",
"text": "やきおまんじゅう"
},
{
"key": "sg_knadana_1",
"who": "gao",
"text": "くまくんは やきおまんじゅう！"
},
{
"key": "sg_knadana_2",
"who": "gao",
"text": "きょうから やきおまんじゅう！"
},
{
"key": "sg_knadana_3",
"who": "gao",
"text": "きょうから くまくんは やきおまんじゅう！"
},
{
"key": "sg_knadana_4",
"who": "gao",
"text": "やった、かった！ きょうから くまくんは やきおまんじゅう！"
},
{
"key": "sg_knadana_5",
"who": "gao",
"text": "やった、かった！ きょうから くまくんは やきおまんじゅうだよ。ほかほかで おいしそう！"
},
{
"key": "sx_knadana_2",
"who": "gao",
"text": "きょうからを やきおまんじゅう！"
},
{
"key": "sq_knsasou",
"who": "tora",
"text": "ねえ、あだなじゃんけん しよう！"
},
{
"key": "sq_knoshieru",
"who": "panna",
"text": "ねえ、あだなじゃんけんって なあに？"
},
{
"key": "sg_knurayamashii_3",
"who": "gao",
"text": "いえに かえってから、おうちの ひとと おいでよ"
},
{
"key": "sg_knurayamashii_4",
"who": "gao",
"text": "いちど いえに かえってから、おうちの ひとと いっしょに おいでよ"
},
{
"key": "sg_knurayamashii_5",
"who": "gao",
"text": "ちゅうくんも、いちど いえに かえってから、おうちの ひとと いっしょに おいでよ。まってるね"
},
{
"key": "sg_knsasoi_5",
"who": "gao",
"text": "よりみちは、がっこうの きまりで だめだよ。いちど いえに かえってから、おうちの ひとに いって あそぼう"
},
{
"key": "sg_ymnaniyomu_3",
"who": "kon",
"text": "きょうりゅうの ほんだよ。いっしょに みる？"
},
{
"key": "sg_ymnaniyomu_4",
"who": "kon",
"text": "きょうりゅうの ほんだよ。ティラノサウルスが かっこいいんだ。いっしょに みる？"
}
