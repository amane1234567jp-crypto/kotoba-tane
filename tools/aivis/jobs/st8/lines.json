[{"key": "sg_nendo_4", "who": "kon", "text": "二人は、粘土で動物を作って、並べて飾ろうとしていました"}, {"key": "st_nendo_3", "who": "mii", "text": "かわいい！並べて飾ろうよ"}, {"key": "sg_ninjin_4", "who": "kon", "text": "「甘い！」と言っていたので、おいしいと思ったと思います"}, {"key": "sg_ninjin_5", "who": "kon", "text": "嫌いなにんじんを食べて「おいしい」と言ったので、うれしい気持ちになったと思います"}, {"key": "sg_taiko_4", "who": "kon", "text": "「ごめん」と言っていたので、悪いと思ったと思います"}, {"key": "sr_keshigomu", "who": "nobbo", "text": "そうでしたか。ガオくん、借りるときは「貸して」と言いましょうね"}, {"key": "sq_soup", "who": "meebaa", "text": "ぴょんさんとどしんくんは、何をしていましたか？"}, {"key": "st_enogu_0", "who": "chu", "text": "家族の絵を描いているんだ。ママと、パパと……"}, {"key": "st_nawatobi_2", "who": "gao", "text": "あはは！へたくそー！"}, {"key": "lk_arigatou_t1", "who": "mii", "text": "ぴょんちゃん、優しいわね"}, {"key": "sg_tkkoronda_1", "who": "gao", "text": "ぴょんちゃん、大丈夫？"}]