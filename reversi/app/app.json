{
  "expo": {
    "name": "テレビ電話リバーシ",
    "slug": "marushima-reversi",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "marushima",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F1E6",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F1E6"
    },
    "ios": {
      "bundleIdentifier": "com.uchinoaji.marushima.reversi",
      "buildNumber": "5",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "とおくの相手と顔を見ながら対戦するために、カメラを使います。",
        "NSMicrophoneUsageDescription": "とおくの相手とおしゃべりしながら対戦するために、マイクを使います。",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.uchinoaji.marushima.reversi",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E8A52"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK",
        "INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1E8A52",
          "defaultChannel": "call"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "とおくの相手とおしゃべりしながら対戦するために、マイクを使います。"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "pushReady": false,
      "eas": {
        "projectId": "0b857b49-a1e4-4c91-8e30-a0fcc3d604d3"
      }
    },
    "owner": "uchinoaji-app"
  }
}
