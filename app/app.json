{
  "expo": {
    "name": "ことばのたね",
    "slug": "kotoba-tane",
    "owner": "amane7654321jp",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF8E8",
    "assetBundlePatterns": ["assets/web/*"],
    "ios": {
      "bundleIdentifier": "com.uchinoaji.kotobatane",
      "buildNumber": "1",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false,
        "CFBundleDevelopmentRegion": "ja",
        "CFBundleLocalizations": ["ja"]
      }
    },
    "android": {
      "package": "com.uchinoaji.kotobatane",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-fg.png", "backgroundColor": "#FFC94F" },
      "permissions": ["android.permission.RECORD_AUDIO", "com.android.vending.BILLING"],
      "blockedPermissions": ["android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE", "android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "plugins": [
      ["expo-splash-screen", { "image": "./assets/splash.png", "imageWidth": 220, "backgroundColor": "#FFF8E8" }],
      ["expo-speech-recognition", {
        "microphonePermission": "話す練習で、お子さんの声を聞き取るためにマイクを使います。",
        "speechRecognitionPermission": "お子さんが言った言葉がお手本と合っているかを調べるために、音声認識を使います。",
        "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.tts"]
      }],
      ["expo-iap", { "android": { "store": "play" } }],
      ["expo-build-properties", { "ios": { "deploymentTarget": "16.4" }, "android": { "minSdkVersion": 26 } }]
    ]
  }
}
